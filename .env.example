# APP
DEV_MODE=TRUE
LOG_LEVEL=INFO
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# DB
# Option 1: set DATABASE_URL directly (recommended for Alembic)
DATABASE_URL=
# Option 2: set individual parts (used by app at runtime)
# Docker: use service names as hostnames
# PROD_DB_HOST=db  (instead of localhost)
PROD_DB_NAME=""
PROD_DB_USER=""
PROD_DB_PASSWORD=""
PROD_DB_HOST=""
PROD_DB_PORT=""

# TG
# Docker: INTERNAL_API_URL=http://api:8000
TELEGRAM_BOT_TOKEN=""
INTERNAL_API_URL="http://localhost:8000"
INTERNAL_API_SHARED_SECRET=""
BOT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook/bot
WEBHOOK_SECRET=
TELEGRAM_BOT_SECRET_TOKEN=""

# LLM
OPEN_ROUTER_API_KEY=""
HUGGING_FACE_API_KEY=""
POLLEN_API_KEY=""

# CRYPTO
ENCRYPTION_KEY=

# YANDEX_STORAGE
YANDEX_ACCESS_KEY=
YANDEX_SECRET_KEY=
YANDEX_BUCKET_NAME=
# Docker: REDIS_URL=redis://redis:6379/0
# Docker: CELERY_BROKER_URL=redis://redis:6379/1
# Docker: CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Tailscale
TAILSCALE_AUTH_KEY=tskey-auth-...
TAILSCALE_HOSTNAME=

# Production overrides:
# BOT_MODE=webhook
# WEBHOOK_BASE_URL=https://catruler.tailb0217d.ts.net
# WEBHOOK_SECRET=<random 32 char string>
# TAILSCALE_AUTH_KEY=tskey-auth-...
# TAILSCALE_HOSTNAME=catruler
